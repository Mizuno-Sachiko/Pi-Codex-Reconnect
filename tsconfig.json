{
	"compilerOptions": {
		"target": "ES2023",
		"module": "Node16",
		"moduleResolution": "Node16",
		"resolveJsonModule": true,
		"strict": true,
		"noEmit": true,
		"allowImportingTsExtensions": true,
		"verbatimModuleSyntax": true,
		"erasableSyntaxOnly": true,
		"noUncheckedIndexedAccess": true,
		"types": ["node"]
	},
	"include": ["*.ts"]
}
